# ── Embedding Model ───────────────────────────────────────────────────────
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=1536

# ── Vector store ───────────────────────────────────────────────────────
# Docker Qdrant REST endpoint (see docker-compose.yml).
QDRANT_URL=http://localhost:6333

# ── LLM via OpenRouter ─────────────────────────────────────────────────
# API key for the OpenRouter account. Never commit a real key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Choose `llm` for a chat model or `decision` for a typed decision model.
CLASSIFIER_BACKEND=llm
# With llm, choose an OpenRouter chat model that supports structured output.
# With decision, choose an OpenRouter Decisions API model, e.g. typesafe/jev-1.13.
CLASSIFIER_MODEL_ID=google/gemini-2.5-flash
# Model ID used by the agent when composing the answer from retrieved chunks.
ANSWER_MODEL_ID=google/gemini-2.5-flash

# ── App / observability ────────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Force stdout to be unbuffered so logs appear live during a demo.
PYTHONUNBUFFERED=1
